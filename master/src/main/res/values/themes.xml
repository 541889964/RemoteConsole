<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RemoteConsole" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>
    <style name="Theme.RemoteConsole.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_primary</item>
        <item name="postSplashScreenTheme">@style/Theme.RemoteConsole</item>
    </style>
</resources>
